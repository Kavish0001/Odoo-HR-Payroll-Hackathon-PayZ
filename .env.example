# ---- Database ----------------------------------------------------------
# Postgres runs in Docker on host port 5433: 5432 is occupied on this machine.
DATABASE_URL="postgresql://payz:payz@localhost:5433/payz?schema=public"

# ---- API ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Must be at least 32 characters. The server refuses to boot otherwise.
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- Email (Gmail SMTP) ------------------------------------------------
# Requires 2-Step Verification and a 16-character App Password, not the
# account password. Leave SMTP_USER empty to fall back to a console
# transport so Send Payslips stays demoable with no network.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PayZ Payroll <you@gmail.com>"

# Redirects every outgoing mail here in development, so seeded demo
# addresses can never be emailed by accident.
MAIL_REDIRECT_TO=

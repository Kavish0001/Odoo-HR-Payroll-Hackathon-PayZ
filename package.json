{
  "name": "payz",
  "version": "0.1.0",
  "private": true,
  "description": "PayZ - Integrated HR & Payroll platform (Odoo HR Payroll Hackathon)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "npm run -w server db:migrate",
    "db:seed": "npm run -w server db:seed",
    "mail:check": "npm run -w server mail:check --",
    "db:studio": "npm run -w server db:studio",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run -w server dev",
    "dev:web": "npm run -w client dev",
    "build": "npm run -w shared build && npm run -w server build && npm run -w client build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run -w shared typecheck && npm run -w server typecheck && npm run -w client typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "npm run db:seed"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "vite": "^6.4.3",
    "qs": "^6.15.4",
    "deepmerge-ts": "^8.0.0"
  }
}
